<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterActivity"
    android:background="@color/black"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/very_apk"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:backgroundTint="@color/b_black"
        android:background="@drawable/corner_25"
        app:layout_constraintTop_toBottomOf="@id/back_derive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/very_apk"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bio_global"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/biometric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/fingerprint"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/info_bio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/info"
            app:layout_constraintTop_toBottomOf="@id/biometric"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/info_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/back_global"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBaseline_toTopOf="parent"
        android:src="@drawable/spy_risk"
        />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/back_global"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:fitsSystemWindows="true"
        android:background="@color/black"
        >

        <TextView
            android:id="@+id/information_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your password"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/opor"
            android:layout_marginBottom="20dp"
            android:textSize="20dp"
            android:fontFamily="@font/pixel"
            android:textAllCaps="false"
            />

        <TextView
            android:id="@+id/opor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="**********"
            app:layout_constraintEnd_toEndOf="@id/back_pass"
            app:layout_constraintStart_toStartOf="@id/back_pass"
            app:layout_constraintBottom_toTopOf="@id/back_pass"
            android:layout_marginBottom="10dp"
            android:textSize="17dp"
            android:textColor="@color/n_blue"
            />

     <androidx.constraintlayout.widget.ConstraintLayout
         android:id="@+id/back_pass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/corner_25"
        android:backgroundTint="@color/b_black"
        app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

         <com.google.android.material.textfield.TextInputLayout
             android:id="@+id/input_salt_background"
             android:layout_width="200dp"
             android:layout_height="wrap_content"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintBottom_toTopOf="@id/input_password_background"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:boxStrokeColor="@color/style_edit_text"
             android:textColorHint="@color/n_white"
             app:hintTextColor="@color/n_white"
             app:cursorColor="@color/n_white"
             app:passwordToggleEnabled="true"
             app:passwordToggleTint="@color/n_white"
             >

             <EditText
                 android:id="@+id/input_salt"
                 android:layout_width="200dp"
                 android:layout_height="wrap_content"
                 android:hint="Salt"
                 android:textColorHint="@color/n_white"
                 android:textColor="@color/n_white"
                 android:fontFamily="monospace"
                 android:maxWidth="200dp"
                 android:maxLines="2"
                 android:layout_marginEnd="20dp"
                 android:gravity="center"
                 android:inputType="textPassword"
                 />

         </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_password_background"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/input_iter_background"
            app:layout_constraintTop_toBottomOf="@id/input_salt_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:boxStrokeColor="@color/style_edit_text"
            android:textColorHint="@color/n_white"
            app:hintTextColor="@color/n_white"
            app:cursorColor="@color/n_white"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/n_white"
            >

            <EditText
                android:id="@+id/input_password"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:textColorHint="@color/n_white"
                android:textColor="@color/n_white"
                android:fontFamily="monospace"
                android:maxWidth="200dp"
                android:maxLines="2"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:inputType="textPassword"
                />

        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_pass"
            android:layout_width="100dp"
            android:layout_height="5dp"
            app:layout_constraintEnd_toEndOf="@id/input_password_background"
            app:layout_constraintStart_toStartOf="@id/input_password_background"
            app:layout_constraintTop_toBottomOf="@id/input_password_background"
            app:layout_constraintBottom_toTopOf="@id/input_iter_background"
            app:trackColor="@color/b_black"
            app:indicatorColor="@color/b_black"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            />

        <com.google.android.material.textfield.TextInputLayout
             android:id="@+id/input_iter_background"
             android:layout_width="200dp"
             android:layout_height="wrap_content"
             app:layout_constraintTop_toBottomOf="@id/progress_pass"
             app:layout_constraintBottom_toBottomOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:boxStrokeColor="@color/style_edit_text"
             android:textColorHint="@color/n_white"
             app:hintTextColor="@color/n_white"
             app:cursorColor="@color/n_white"
             app:passwordToggleEnabled="true"
             app:passwordToggleTint="@color/n_white"
             android:layout_marginBottom="20dp"
             >

             <EditText
                 android:id="@+id/input_iter"
                 android:layout_width="200dp"
                 android:layout_height="wrap_content"
                 android:hint="Iter"
                 android:textColorHint="@color/n_white"
                 android:textColor="@color/n_white"
                 android:fontFamily="monospace"
                 android:maxWidth="200dp"
                 android:maxLines="2"
                 android:layout_marginEnd="20dp"
                 android:gravity="center"
                 android:inputType="numberPassword"
                 />

        </com.google.android.material.textfield.TextInputLayout>

     </androidx.constraintlayout.widget.ConstraintLayout>


        <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/create_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/nowivault_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_pass"
        android:layout_marginTop="20dp"
        />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pas_gen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/create_password"
            app:layout_constraintBottom_toBottomOf="@id/create_password"
            app:layout_constraintEnd_toStartOf="@id/create_password"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/corner_25"
            android:backgroundTint="@color/b_black"
            >

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/generator"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/secure_visibility"
            android:layout_width="45dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@id/back_pass"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/create_password"
            android:background="@drawable/corner_25"
            android:backgroundTint="@color/b_black"
            android:layout_marginTop="20dp"
            >

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/visibility_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/prism_no_rell"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/back_derive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/back_global"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/derived_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Derived Key mode"
            android:fontFamily="monospace"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/info_derived"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/info"
            app:layout_constraintTop_toTopOf="@id/derived_check"
            app:layout_constraintBottom_toBottomOf="@id/derived_check"
            app:layout_constraintStart_toEndOf="@id/derived_check"
            android:layout_marginStart="15dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A Nowi Product :)"
        android:textSize="20dp"
        android:fontFamily="@font/pixel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="10dp"
        android:textColor="@color/n_blue"
        />

</androidx.constraintlayout.widget.ConstraintLayout>